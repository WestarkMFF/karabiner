{
  "title": "MFF PRO v1",
  "rules": [
    {
      "description": "[basic] Mac custom key file -- built-in keyboard",
      "manipulators": [
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "q" },
          "to": [{ "repeat": true, "key_code": "1" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "w" },
          "to": [{ "repeat": true, "key_code": "2" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "e" },
          "to": [{ "repeat": true, "key_code": "3" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "r" },
          "to": [{ "repeat": true, "key_code": "4" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "t" },
          "to": [{ "repeat": true, "key_code": "5" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "y" },
          "to": [{ "repeat": true, "key_code": "6" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "u" },
          "to": [{ "repeat": true, "key_code": "7" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "i" },
          "to": [{ "repeat": true, "key_code": "8" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "o" },
          "to": [{ "repeat": true, "key_code": "9" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "p" },
          "to": [{ "repeat": true, "key_code": "0" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "n" },
          "to": [{ "repeat": true, "key_code": "hyphen" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "m" },
          "to": [{ "repeat": true, "key_code": "equal_sign" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "f" },
          "to": [{ "repeat": true, "key_code": "quote" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "a" },
          "to": [{ "repeat": true, "key_code": "open_bracket" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "s" },
          "to": [{ "repeat": true, "key_code": "close_bracket" }]
        },

        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "open_bracket" },
          "to": [{ "repeat": true, "key_code": "open_bracket" }]
        },

        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "close_bracket" },
          "to": [{ "repeat": true, "key_code": "close_bracket" }]
        },

        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "a"
          },
          "to": [{ "repeat": true, "key_code": "open_bracket", "modifiers": ["left_shift"] }]
        },

        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "open_bracket"
          },
          "to": [{ "repeat": true, "key_code": "open_bracket", "modifiers": ["left_shift"] }]
        },

        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "close_bracket"
          },
          "to": [{ "repeat": true, "key_code": "close_bracket", "modifiers": ["left_shift"] }]
        },

        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "s"
          },
          "to": [{ "repeat": true, "key_code": "close_bracket", "modifiers": ["left_shift"] }]
        },

        {
          "type": "basic",
          "from": { "key_code": "f12" },
          "to": [{ "repeat": true, "key_code": "j", "modifiers": ["left_alt", "left_gui"] }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "d" },
          "to": [{ "repeat": true, "key_code": "j", "modifiers": ["left_alt", "left_gui"] }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "spacebar" },
          "to": [{ "repeat": true, "key_code": "return_or_enter" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "tab" },
          "to": [{ "repeat": true, "key_code": "tab" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["left_control"] }, "key_code": "escape" },
          "to": [{ "repeat": true, "modifiers": ["left_gui"], "key_code": "w" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "semicolon" },
          "to": [{ "repeat": true, "key_code": "delete_or_backspace" }]
        },
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui", "left_gui"] }, "key_code": "semicolon" },
          "to": [{ "repeat": true, "key_code": "delete_or_backspace", "modifiers": ["left_gui"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "q"
          },
          "to": [{ "repeat": true, "key_code": "1", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "w"
          },
          "to": [{ "repeat": true, "key_code": "2", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "e"
          },
          "to": [{ "repeat": true, "key_code": "3", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "r"
          },
          "to": [{ "repeat": true, "key_code": "4", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "t"
          },
          "to": [{ "repeat": true, "key_code": "5", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "y"
          },
          "to": [{ "repeat": true, "key_code": "6", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "u"
          },
          "to": [{ "repeat": true, "key_code": "7", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "i"
          },
          "to": [{ "repeat": true, "key_code": "8", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "o"
          },
          "to": [{ "repeat": true, "key_code": "9", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "p"
          },
          "to": [{ "repeat": true, "key_code": "0", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "n"
          },
          "to": [{ "repeat": true, "key_code": "hyphen", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "m"
          },
          "to": [{ "repeat": true, "key_code": "equal_sign", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "f"
          },
          "to": [{ "repeat": true, "key_code": "quote", "modifiers": ["left_shift"] }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "spacebar"
          },
          "to": [{ "repeat": true, "key_code": "return_or_enter" }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["left_control"] },
            "key_code": "d"
          },
          "to": [
            {
              "repeat": true,
              "modifiers": ["left_alt", "left_shift"],
              "key_code": "left_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["left_control"] },
            "key_code": "h"
          },
          "to": [
            {
              "repeat": true,
              "modifiers": ["left_control"],
              "key_code": "left_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["left_control"] },
            "key_code": "l"
          },
          "to": [
            {
              "repeat": true,
              "modifiers": ["left_control"],
              "key_code": "right_arrow"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"] },
            "key_code": "period"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "period"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"] },
            "key_code": "comma"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "comma"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"] },
            "key_code": "g"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "grave_accent_and_tilde"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "g"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "grave_accent_and_tilde",
              "modifiers": "left_shift"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"] },
            "key_code": "c"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "f12",
              "modifiers": "left_shift"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"] },
            "key_code": "v"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "f20"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": { "mandatory": ["right_gui"], "optional": ["left_shift"] },
            "key_code": "v"
          },
          "to": [
            {
              "repeat": true,
              "key_code": "f20",
              "modifiers": ["left_shift"]
            }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "right_shift" },
          "to": [{ "key_code": "right_shift" }],
          "to_if_alone": [{ "key_code": "f15" }]
        },
        {
          "type": "basic",
          "from": {
            "modifiers": {
              "mandatory": ["right_shift"]
            },
            "key_code": "n"
          },
          "to": [
            {
              "modifiers": ["left_shift"],
              "key_code": "f2"
            }
          ]
        }
      ]
    },
    {
      "description": "[basic] Mac custom key file -- toggle app -- cmd + space 2 instead of cmd + tab",
      "manipulators": [
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["left_gui"] }, "key_code": "spacebar" },
          "to": [{ "repeat": true, "key_code": "tab", "modifiers": ["left_gui"] }]
        }
      ]
    },
    {
      "description": "[basic] Mac custom key file -- SuperLeft + zxcvb = f{*}",
      "manipulators": [
        {
          "type": "basic",
          "from": { "modifiers": { "mandatory": ["right_gui"] }, "key_code": "c" },
          "to": [{ "repeat": true, "key_code": "f19" }]
        }
      ]
    },
    {
      "description": "[basic] Custom complex key",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "spacebar" },
          "to": [{ "key_code": "left_control" }],
          "to_if_alone": [{ "key_code": "spacebar" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "left_shift" },
          "to": [{ "key_code": "left_shift" }],
          "to_if_alone": [{ "key_code": "f12" }]
        }
      ]
    },
    {
      "description": "[iTerm2] Change Cmd+B to Alt+B in iTerm2",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": ["command"]
            }
          },
          "to": [
            {
              "key_code": "b",
              "modifiers": ["option"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^com\\.googlecode\\.iterm2"]
            }
          ]
        }
      ]
    }
  ]
}
