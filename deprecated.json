{
  "title": "[DEPRECATED] Tapping modifier-keys produces a f-key.",
  "rules": [
    {
      "description": "[DEPRECATED] Press left_shift alone produce fn ( switch trigger method )",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "left_shift" },
          "to": [{ "key_code": "left_shift" }],
          "to_if_alone": [
            {
              "apple_vendor_top_case_key_code": "keyboard_fn"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press left_control alone produces F13",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f13"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press left_command alone produces F14",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f14"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press left_option alone produces F15",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f15"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press right_control alone produces F16",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_control",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f16"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press right_command alone produces F17",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_command"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f17"
            }
          ]
        }
      ]
    },
    {
      "description": "[DEPRECATED] Press right_alt alone produces F18",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_alt",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "right_alt"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "f18"
            }
          ]
        }
      ]
    },
    {
      "description": "Disable Option special characters in VS Code",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": [{ "key_code": "f19", "modifiers": ["left_shift"] }],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "com.microsoft.VSCodeInsiders",
                "com.microsoft.VSCode"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": [{ "key_code": "f20", "modifiers": ["left_shift"] }],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "com.microsoft.VSCodeInsiders",
                "com.microsoft.VSCode"
              ]
            }
          ]
        }
      ]
    }
  ]
}
