{
  "title": "for mac build-in key only",
  "rules": [
    {
      "description": "[mac_build_in] [🔊] Press right_alt + up_arrow to volume up",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "up_arrow", "modifiers": { "mandatory": ["right_alt"] } },
          "to": [{ "repeat": true, "key_code": "volume_increment" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "down_arrow", "modifiers": { "mandatory": ["right_alt"] } },
          "to": [{ "repeat": true, "key_code": "volume_decrement" }]
        }
      ]
    }
  ]
}
